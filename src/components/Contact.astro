---
import { Phone, Mail, MapPin } from 'lucide-astro';
import type { Translations } from '../types';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

const serviceOptions: string[] = [
  ...t.services.residential.items,
  ...t.services.construction.items,
  ...t.services.handyman.items,
  ...t.services.interior.items,
];
---

<section
  id="contact"
  class="py-20 bg-gradient-to-br from-cyan-dark via-cyan-light to-cyan-dark text-white"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Header */}
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-4">{t.contact.title}</h2>
      <div class="w-24 h-1 bg-yellow-custom mx-auto mb-6"></div>
      <p class="text-lg text-white/90 max-w-3xl mx-auto">
        {t.contact.subtitle}
      </p>
    </div>

    {/* Contact cards */}
    <div class="grid md:grid-cols-3 gap-8 mb-12">
      {/* Phone */}
      <a
        href="tel:+17205550123"
        class="contact-card bg-white/10 backdrop-blur-md rounded-2xl p-8 border-2 border-white/20 hover:border-[#045a52] transition-all hover:-translate-y-2 hover:shadow-2xl"
      >
        <div class="w-16 h-16 bg-yellow-custom rounded-xl flex items-center justify-center mb-6">
          <Phone class="w-8 h-8 text-cyan-dark" />
        </div>
        <h3 class="text-xl font-bold mb-2">{t.contact.cta}</h3>
        <p class="text-white/80 font-semibold">+1 (720) 555-0123</p>
      </a>

      {/* Email (opens modal) */}
      <a
        href="#"
        data-toggle-form="true"
        class="contact-card bg-white/10 backdrop-blur-md rounded-2xl p-8 border-2 border-white/20 hover:border-[#045a52] transition-all hover:-translate-y-2 hover:shadow-2xl"
      >
        <div class="w-16 h-16 bg-yellow-custom rounded-xl flex items-center justify-center mb-6">
          <Mail class="w-8 h-8 text-cyan-dark" />
        </div>
        <h3 class="text-xl font-bold mb-2">{t.contact.email}</h3>
        <p class="text-white/80 font-semibold">info@ferhandy.com</p>
      </a>

      {/* Location */}
      <div
        class="contact-card bg-white/10 backdrop-blur-md rounded-2xl p-8 border-2 border-white/20"
      >
        <div class="w-16 h-16 bg-yellow-custom rounded-xl flex items-center justify-center mb-6">
          <MapPin class="w-8 h-8 text-cyan-dark" />
        </div>
        <h3 class="text-xl font-bold mb-2">Location</h3>
        <p class="text-white/80 font-semibold">Colorado, USA</p>
      </div>
    </div>

    {/* CTA */}
    <div class="flex justify-center gap-4">
      <button
        data-toggle-form="true"
        class="inline-flex items-center gap-3 bg-yellow-custom text-cyan-dark font-bold px-8 py-4 rounded-xl shadow-xl hover:bg-[#045a52] hover:text-white transition-all"
      >
        <Mail class="w-5 h-5" />
        {t.contact.email}
      </button>
    </div>
  </div>
</section>

{/* ================= MODAL ================= */}
<div
  id="form-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center"
>
  {/* Overlay */}
  <div
    id="form-overlay"
    class="absolute inset-0 bg-black/60 backdrop-blur-sm"
  ></div>

  {/* Modal */}
  <div class="relative z-10 w-full max-w-3xl mx-4">
    <form
      id="contact-form"
      class="bg-white/10 backdrop-blur-md rounded-2xl p-8 border-2 border-white/20 relative text-white"
    >
      {/* Close */}
      <button
        type="button"
        id="close-form"
        class="absolute top-4 right-4 text-2xl text-white hover:text-yellow-custom"
      >
        ×
      </button>

      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-semibold mb-2">
            {t.contact.form.name}
          </label>
          <input
            type="text"
            name="name"
            required
            class="w-full px-4 py-3 rounded-xl bg-white/80 text-cyan-dark focus:ring-2 focus:ring-yellow-custom"
          />
        </div>

        <div>
          <label class="block text-sm font-semibold mb-2">
            {t.contact.form.phone}
          </label>
          <input
            type="tel"
            name="phone"
            required
            class="w-full px-4 py-3 rounded-xl bg-white/80 text-cyan-dark focus:ring-2 focus:ring-yellow-custom"
          />
        </div>

        <div>
          <label class="block text-sm font-semibold mb-2">
            {t.contact.form.email}
          </label>
          <input
            type="email"
            name="email"
            required
            class="w-full px-4 py-3 rounded-xl bg-white/80 text-cyan-dark focus:ring-2 focus:ring-yellow-custom"
          />
        </div>

        <div>
          <label class="block text-sm font-semibold mb-2">
            {t.contact.form.service}
          </label>
          <select
            id="service-select"
            name="service"
            required
            class="w-full px-4 py-3 rounded-xl bg-white/80 text-cyan-dark focus:ring-2 focus:ring-yellow-custom"
          >
            <option value="" disabled selected>
              {t.contact.form.service}
            </option>
            <optgroup label={t.services.residential.title}>
              {t.services.residential.items.map((s) => (
                <option value={s}>{s}</option>
              ))}
            </optgroup>
            <optgroup label={t.services.construction.title}>
              {t.services.construction.items.map((s) => (
                <option value={s}>{s}</option>
              ))}
            </optgroup>
            <optgroup label={t.services.handyman.title}>
              {t.services.handyman.items.map((s) => (
                <option value={s}>{s}</option>
              ))}
            </optgroup>
            <optgroup label={t.services.interior.title}>
              {t.services.interior.items.map((s) => (
                <option value={s}>{s}</option>
              ))}
            </optgroup>
            <option value="__other__">{t.contact.form.other}</option>
          </select>
        </div>
      </div>

      <div class="mt-6">
        <p
          id="service-warning"
          class="text-yellow-300 text-sm mb-2 hidden"
        >
          {t.contact.form.specifyWarning}
        </p>

        <label class="block text-sm font-semibold mb-2">
          {t.contact.form.message}
        </label>
        <textarea
          name="message"
          rows="4"
          class="w-full px-4 py-3 rounded-xl bg-white/80 text-cyan-dark focus:ring-2 focus:ring-yellow-custom"
        ></textarea>
      </div>

      <div class="mt-8 flex items-center gap-4">
        <button
          type="submit"
          class="bg-yellow-custom text-cyan-dark font-bold px-8 py-4 rounded-xl hover:bg-[#045a52] hover:text-white transition-all"
        >
          {t.contact.form.submit}
        </button>
        <span id="form-status"></span>
      </div>
    </form>
  </div>
</div>

<style>
  .contact-card {
    animation: fadeInUp 0.6s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const modal = document.getElementById('form-modal');
  const overlay = document.getElementById('form-overlay');
  const closeBtn = document.getElementById('close-form');
  const toggleEls = document.querySelectorAll('[data-toggle-form="true"]');

  const openModal = () => {
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  const closeModal = () => {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  };

  toggleEls.forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      openModal();
    });
  });

  overlay.addEventListener('click', closeModal);
  closeBtn.addEventListener('click', closeModal);

  const serviceSelect = document.getElementById('service-select');
  const serviceWarning = document.getElementById('service-warning');

  serviceSelect?.addEventListener('change', () => {
    serviceWarning.classList.toggle(
      'hidden',
      serviceSelect.value !== '__other__'
    );
  });
</script>
